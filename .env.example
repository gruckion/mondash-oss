# Copy only the variables you need into .env at the repository root.
# Enable the corresponding source in Settings; having a secret does not enable it.
# Keep .env, mondash.local.json, .mcp-auth and .cache private.
# LINEAR_API_KEY=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Optional Socket Mode; polling works without it.
# SLACK_APP_TOKEN=
# Optional paid classification (both values required).
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=
# Optional phone notifications; topic is a credential.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Optional trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Existing runtime environment overrides continue to take precedence.
# MONDASH_PORT=3456
# MONDASH_HOST=127.0.0.1
# MONDASH_PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443
# MONDASH_EXPO_GO_URL=exp://your-tailnet-ip:8081
# TERMINAL_APP=Terminal
# MONDASH_CLAUDE_BIN=/absolute/path/to/claude
# MONDASH_NEW_SESSION_DIR=/absolute/path/to/projects
# MONDASH_PROFILE=/absolute/path/to/mondash.local.json
